# Anchor — local development environment
#
# `bin/setup` copies this file to `.env` (never committed) and fills in a
# random ENCRYPTION_KEY. dotenv-rails loads `.env` in development and test.
#
# Everything below works WITHOUT any cloud account: deploy the seeded demo
# project with the "Local Docker" provider and sign in with the dev login.

# ── Core ──────────────────────────────────────────────────────────────────
# 32+ random characters. Encrypts GitHub tokens, cloud keys and app secrets.
# Changing it makes existing encrypted rows unreadable — keep it stable.
ENCRYPTION_KEY=

# Postgres: config/database.yml already uses anchor_development / anchor_test
# on localhost. Do NOT set DATABASE_URL here — dotenv also loads this file in
# the test environment, and a DATABASE_URL would point rspec at your dev DB.
# docker-compose sets DATABASE_URL per container instead.
REDIS_URL=redis://localhost:6379/0

# ── Dev login (development only) ─────────────────────────────────────────
# 1 = show "Continue as demo user" on the landing page, which signs you in as
# the seeded demo user without GitHub OAuth. Ignored in every other
# environment (see DashboardController.dev_login_enabled?).
ANCHOR_DEV_LOGIN=1

# ── GitHub OAuth (optional for local trials) ─────────────────────────────
# The app refuses to boot in development if these are blank, so placeholders
# are fine when you only use the dev login. For real sign-in, create an OAuth
# app at https://github.com/settings/developers with callback
# http://localhost:3000/auth/github/callback
GITHUB_CLIENT_ID=dev-placeholder
GITHUB_CLIENT_SECRET=dev-placeholder
GITHUB_WEBHOOK_SECRET=

# ── Google Cloud Run provider (optional) ─────────────────────────────────
# Only needed to deploy to Google Cloud Run. Leave blank for Local Docker.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── AI error explanations (optional) ─────────────────────────────────────
# Without a key, failed deploys still show the error category and a
# rule-based hint; the plain-English explanation is skipped.
OPENAI_API_KEY=
