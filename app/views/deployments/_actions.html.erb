<%# locals: (deployment:) %>
<%# Cancel while in progress; Redeploy / Roll back once finished. Updated by
    Deployment#broadcast_status_update on every status change. %>
<% if deployment.in_progress? %>
  <%= button_to cancel_project_deployment_path(deployment.project, deployment),
        method: :post,
        data: { turbo_confirm: "Cancel this deployment?" },
        class: "mb-2 inline-flex items-center gap-1.5 text-xs text-red-400 hover:text-red-300 border border-red-800 hover:border-red-600 px-3 py-1.5 rounded-lg transition-colors" do %>
    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"/>
    </svg>
    Cancel deployment
  <% end %>
<% elsif deployment.terminal? %>
  <%= button_to redeploy_project_path(deployment.project),
        method: :post,
        class: "mb-2 inline-flex items-center gap-1.5 text-xs text-indigo-400 hover:text-indigo-300 border border-indigo-800 hover:border-indigo-600 px-3 py-1.5 rounded-lg transition-colors" do %>
    <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
      <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 4v5h.582m15.356 2A8.001 8.001 0 004.582 9m0 0H9m11 11v-5h-.581m0 0a8.003 8.003 0 01-15.357-2m15.357 2H15"/>
    </svg>
    Redeploy
  <% end %>
  <%= render "deployments/rollback_button", deployment: deployment %>
<% end %>
