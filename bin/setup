#!/usr/bin/env ruby
# frozen_string_literal: true

# Sets up (or updates) a local Anchor development environment.
#
# Idempotent: safe to re-run at any time. Each step checks before acting and
# prints a concrete fix when a prerequisite is missing.
#
#   bin/setup                 # check tools, .env, gems, CSS, database, seeds, then start bin/dev
#   bin/setup --skip-server   # everything except starting the server
#   bin/setup --reset         # drop and recreate the development database first
#
# Prefer containers? `docker compose up` runs the same stack (see docker-compose.yml).

require "fileutils"
require "securerandom"

APP_ROOT = File.expand_path("..", __dir__)
RUBY_WANTED = File.read(File.join(APP_ROOT, ".ruby-version")).strip

def step(title)
  puts "\n== #{title} =="
end

def ok(msg)   = puts("   ok   #{msg}")
def warn!(msg) = puts("   warn #{msg}")

def fail!(msg, fix)
  puts "   FAIL #{msg}"
  puts "        fix: #{fix}"
  puts "\n   Or skip local installs entirely:  docker compose up"
  exit 1
end

def system!(*args)
  system(*args, exception: true)
end

def command?(name)
  system("command -v #{name} > /dev/null 2>&1")
end

FileUtils.chdir APP_ROOT do
  # ── 1. Prerequisites ─────────────────────────────────────────────────────
  step "Checking prerequisites"

  if RUBY_VERSION == RUBY_WANTED
    ok "ruby #{RUBY_VERSION}"
  else
    fail! "ruby #{RUBY_VERSION} is active, Anchor needs #{RUBY_WANTED}",
          "install it with your version manager, e.g. `rbenv install #{RUBY_WANTED}` or `mise use ruby@#{RUBY_WANTED}`"
  end

  if command?("pg_isready")
    if system("pg_isready -q")
      ok "postgres is accepting connections"
    else
      fail! "postgres is installed but not running",
            "`brew services start postgresql@16` (macOS) or `sudo systemctl start postgresql` (Linux)"
    end
  else
    fail! "postgres client tools not found",
          "`brew install postgresql@16 && brew services start postgresql@16` (macOS) or `sudo apt install postgresql` (Linux)"
  end

  if command?("redis-cli")
    if `redis-cli ping 2>/dev/null`.strip == "PONG"
      ok "redis is running"
    else
      fail! "redis is installed but not running",
            "`brew services start redis` (macOS) or `sudo systemctl start redis-server` (Linux)"
    end
  else
    fail! "redis not found",
          "`brew install redis && brew services start redis` (macOS) or `sudo apt install redis-server` (Linux)"
  end

  # Docker is only needed to actually run deployments with the Local Docker
  # provider, so a missing daemon is a warning, not a failure.
  if command?("docker") && system("docker info > /dev/null 2>&1")
    ok "docker daemon is running (Local Docker provider will work)"
  else
    warn! "docker is not running — the app works, but Local Docker deploys will fail until it is"
    warn! "install Docker Desktop / OrbStack / colima and start it"
  end

  # ── 2. Environment file ──────────────────────────────────────────────────
  step "Preparing .env"

  if File.exist?(".env")
    ok ".env already exists (left untouched)"
  else
    FileUtils.cp ".env.example", ".env"
    ok "copied .env.example -> .env"
  end

  env = File.read(".env")
  if env.match?(/^ENCRYPTION_KEY=\S+/)
    ok "ENCRYPTION_KEY present"
  else
    key = SecureRandom.hex(32)
    env = env.match?(/^ENCRYPTION_KEY=/) ? env.sub(/^ENCRYPTION_KEY=.*$/, "ENCRYPTION_KEY=#{key}") : env + "\nENCRYPTION_KEY=#{key}\n"
    File.write(".env", env)
    ok "generated a development ENCRYPTION_KEY"
  end

  # ── 3. Dependencies ──────────────────────────────────────────────────────
  step "Installing gems"
  system("bundle check > /dev/null 2>&1") || system!("bundle install")
  ok "bundle complete"

  step "Building CSS"
  system! "bin/rails tailwindcss:build > /dev/null"
  ok "tailwind build written to app/assets/builds"

  # ── 4. Database ──────────────────────────────────────────────────────────
  step "Preparing database"
  system! "bin/rails db:drop" if ARGV.include?("--reset")
  # db:prepare creates + loads schema on first run, migrates afterwards, and
  # runs db/seeds.rb only when it created the database.
  system! "bin/rails db:prepare"
  # Seeds are idempotent, so always re-run them to pick up new demo data.
  system! "bin/rails db:seed"

  step "Removing old logs and tempfiles"
  system! "bin/rails log:clear tmp:clear"

  puts <<~DONE

    == Ready ==
       Start:   bin/dev            (web on http://localhost:3000 + Sidekiq worker)
       Sign in: click "Continue as demo user" (ANCHOR_DEV_LOGIN=1 in .env)
       Deploy:  open the "hello-anchor" demo project and press Deploy — it runs on
                your local Docker, no cloud account needed.
       Tests:   bundle exec rspec
  DONE

  unless ARGV.include?("--skip-server")
    step "Starting development server"
    $stdout.flush # flush the output before exec(2) so that it displays
    exec "bin/dev"
  end
end
